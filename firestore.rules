rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUserSettings(data) {
      return data.keys().hasAll(['baseIncome', 'payday']) && 
             data.baseIncome is number &&
             data.payday is number &&
             data.payday >= 1 && data.payday <= 31;
    }

    function isValidFixedExpense(data) {
      return data.keys().hasAll(['description', 'amount', 'category', 'justification']) &&
             data.description is string && data.description.size() <= 200 &&
             data.amount is number &&
             data.justification is string && data.justification.size() <= 1000 &&
             data.category in ['NEED', 'WANT', 'SAVING', 'INCOME'];
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['description', 'amount', 'category', 'subcategory', 'date', 'justification']) &&
             data.description is string && data.description.size() <= 200 &&
             data.amount is number &&
             data.justification is string && data.justification.size() <= 1000 &&
             data.category is string &&
             data.subcategory is string &&
             data.date is string &&
             // Handle optional fields and server timestamps
             (data.get('createdAt', request.time) is timestamp) &&
             (data.get('interestAmount', 0) is number) &&
             (data.get('dueDate', '') is string);
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['name', 'price', 'priority', 'justification']) &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number &&
             data.justification is string && data.justification.size() <= 1000 &&
             data.priority in [1, 2, 3];
    }

    // --- Collections ---

    // Connection test document
    match /test/connection {
      allow get: if isSignedIn();
    }

    match /users/{userId} {
      // User settings
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserSettings(incoming());

      // Sub-collections
      match /fixedExpenses/{expenseId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFixedExpense(incoming());
        allow delete: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTransaction(incoming());
        allow delete: if isOwner(userId);
      }

      match /wishlist/{itemId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidWishlistItem(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
